# Oscillatory shear of an oxidatively crosslinked fibre network -> G', G''
# generated by oxt/lammps_export.py; run: lmp -in colI_iso.in
units           lj
dimension       2
boundary        p p p
atom_style      molecular
read_data       colI_iso.data
bond_style      harmonic
bond_coeff 1 0.5 1.0
bond_coeff 2 0.9333335 1.0
bond_coeff 3 1.4333335 1.0
bond_coeff 4 2.6755555 1.0
bond_coeff 5 0.005 1.0
angle_style     harmonic
angle_coeff     1 0.0015 180.0
angle_coeff     2 0.0018666667 60.0
special_bonds   lj/coul 0.0 1.0 1.0
pair_style      zero 1.0
pair_coeff      * *
neighbor        0.3 bin
comm_modify     cutoff 3.0
fix             2d all enforce2d
fix             gag all spring/self 0.0001
min_style       fire
minimize        0 1e-10 20000 200000
velocity        all create 1e-06 4928 dist gaussian
fix             nve all nve
fix             visc all langevin 1e-06 1e-06 1.0 48279
variable        P equal 200.0
fix             shear all deform 1 xy wiggle 0.55425626 ${P} remap v
compute         p all pressure NULL virial
variable        sxy equal -c_p[4]
variable        g equal xy/ly
thermo_style    custom step time v_g v_sxy pe
thermo          50
fix             out all print 10 "${g} ${sxy}" file colI_iso_stress.txt screen no title "gamma sigma_xy"
timestep        0.01
run             100000
